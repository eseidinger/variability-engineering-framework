{
  "apiVersion": "platform.example/v1alpha2",
  "kind": "Application",
  "metadata": {
    "name": "vareng",
    "project": "vareng",
    "environment": "default"
  },
  "spec": {
    "components": [
      {
        "name": "web",
        "type": "service",
        "runtime": {
          "type": "container",
          "image": "eseidinger/variability-engineering-framework:latest"
        },
        "outbound": [
          {
            "dns": "web-odip.apps.eseidinger.de",
            "port": 443
          },
          {
            "dns": "identity.eseidinger.de",
            "port": 443
          }
        ],
        "ports": [
          {
            "name": "http",
            "protocol": "http",
            "port": 8080
          },
          {
            "name": "management",
            "protocol": "http",
            "port": 9000
          }
        ],
        "telemetry": {
          "metrics": {
            "port": "management",
            "path": "/q/metrics"
          },
          "tracing": {
            "enabled": true
          }
        },
        "replicas": 1,
        "exposure": "public",
        "health": {
          "readiness": {
            "path": "/api/status"
          }
        }
      }
    ],
    "configuration": {
      "values": {
        "ENERGY_ODIP_ORIGIN": "https://web-odip.apps.eseidinger.de",
        "ENERGY_ODIP_BINDING_PREFIX": "ACCESS_209A1DDA331C"
      }
    },
    "resources": [
      {
        "name": "database",
        "type": "postgres",
        "profile": "shared-dev",
        "deletionPolicy": "retain"
      }
    ]
  }
}
