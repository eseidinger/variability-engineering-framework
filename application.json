{
  "apiVersion": "platform.example/v1alpha2",
  "kind": "Application",
  "metadata": {
    "name": "vareng",
    "project": "vareng",
    "environment": "default"
  },
  "spec": {
    "components": [
      {
        "name": "web",
        "type": "service",
        "runtime": {
          "type": "container",
          "image": "eseidinger/variability-engineering-framework:${VARENG_IMAGE_TAG}"
        },
        "outbound": [
          {
            "dns": "web-odip.apps.eseidinger.de",
            "port": 443
          },
          {
            "dns": "identity.eseidinger.de",
            "port": 443
          },
          {
            "dns": "api.openai.com",
            "port": 443
          }
        ],
        "ports": [
          {
            "name": "http",
            "protocol": "http",
            "port": 8080
          },
          {
            "name": "management",
            "protocol": "http",
            "port": 9000
          }
        ],
        "telemetry": {
          "metrics": {
            "port": "management",
            "path": "/q/metrics"
          },
          "tracing": {
            "enabled": true
          }
        },
        "replicas": 1,
        "exposure": "public",
        "health": {
          "readiness": {
            "path": "/api/status"
          }
        },
        "bindings": [
          {
            "bindingId": "cfa9fbca-eb41-4834-a757-e942f5eac0c8",
            "envPrefix": ""
          }
        ],
        "resources": {
          "requests": {
            "memory": "256Mi"
          },
          "limits": {
            "memory": "512Mi"
          }
        }
      }
    ],
    "configuration": {
      "values": {
        "ENERGY_ODIP_ORIGIN": "https://web-odip.apps.eseidinger.de",
        "ENERGY_ODIP_BINDING_PREFIX": "ACCESS_209A1DDA331C",
        "ENERGY_AI_ENABLED": "true",
        "ENERGY_AI_MODEL": "gpt-6.1-sol",
        "ENERGY_AI_TIMEOUT": "180s"
      }
    }
  }
}
